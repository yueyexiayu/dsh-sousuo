{
  "name": "sousuo",
  "version": "0.1.13",
  "private": true,
  "description": "DSH desktop plugin: AnySearch provider with rotating API keys on HTTP 402.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/",
    "locale/",
    "cordis.patch.yml",
    "keys.example",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-web": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-web": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/settings-client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"]
    }
  }
}
